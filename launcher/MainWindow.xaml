<Window x:Class="AzusaHexPick.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="梓有妙选｜Azusa HexPick"
        Width="830" Height="710" MinWidth="720" MinHeight="600" WindowStartupLocation="CenterScreen"
        Background="#F3F5FB" Foreground="#252D43" FontFamily="Microsoft YaHei UI" FontSize="14"
        Icon="Assets/app.ico" ThemeMode="Light">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#5965CE"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="MinHeight" Value="38"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#C9D0DF"/>
      <Setter Property="Foreground" Value="#252D43"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#5965CE"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#39459A"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#536077"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="23"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="38"/></Style>
  </Window.Resources>
  <Grid Margin="32,22,32,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="158"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="梓有妙选" FontSize="29" FontWeight="SemiBold"/>
        <TextBlock Text="Azusa HexPick" Foreground="#5965CE" FontSize="14" Margin="0,5,0,0"/></StackPanel>
      <Image x:Name="Signature" Grid.Column="1" Height="84" Stretch="Uniform" ToolTip="阿梓"/>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
      <StackPanel>
        <Border Background="#FFFFFF" CornerRadius="12" Padding="24,22" Margin="0,0,0,18">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="海斗选哪个技能？下一首唱什么？" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock Text="弹幕里的海克斯、出装和点歌建议，帮你数好。&#10;打开副屏，就能看见大家想选什么。" Style="{StaticResource Muted}" Margin="0,12,0,18"/>
              <WrapPanel><Button x:Name="StartButton" Content="开始使用" Style="{StaticResource Primary}" Click="Start_Click" MinWidth="140"/>
                <Button Content="使用教程" Click="Guide_Click"/></WrapPanel>
            </StackPanel>
            <Border Grid.Column="1" CornerRadius="10" Width="100" Height="110" VerticalAlignment="Top"><Image Source="Assets/hero.png" Stretch="Uniform"/></Border>
          </Grid>
        </Border>
        <TextBlock x:Name="ServiceStatus" Text="点「开始使用」，控制台和桌面副屏会一起打开。" Style="{StaticResource Muted}" Margin="2,0,0,16" AutomationProperties.LiveSetting="Polite"/>
        <Expander x:Name="SettingsPanel" Header="首次设置与偏好" IsExpanded="False" Margin="0,0,0,14">
          <StackPanel Margin="8,16,8,8">
            <TextBlock Text="可选：启用装备 AI" FontWeight="SemiBold"/>
            <TextBlock x:Name="KeyHint" Text="仅首次粘贴 DeepSeek API Key，之后不用再填写。跳过也能使用海克斯和点歌。" Style="{StaticResource Muted}" Margin="0,5,0,8"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <PasswordBox x:Name="ApiKey" Padding="10,8" MaxLength="256" AutomationProperties.Name="DeepSeek API Key"/>
              <Button Grid.Column="1" Content="保存密钥" Click="SaveKey_Click" Margin="8,0,0,0"/></Grid>
            <CheckBox x:Name="PhoneMode" Content="允许配对手机查看只读副屏" Margin="0,18,0,6"/>
            <TextBlock Text="修改手机模式需重新启动服务，正在收集时请先结束本轮。" Style="{StaticResource Muted}"/>
            <WrapPanel Margin="0,12,0,0"><Button Content="保存偏好" Click="SaveSettings_Click"/><Button Content="导入旧版设置" Click="Import_Click"/></WrapPanel>
            <Expander Header="维护者设置" Margin="0,16,0,0"><StackPanel Margin="0,12,0,0">
              <TextBlock Text="腾讯问卷公开填写链接" Style="{StaticResource Muted}"/>
              <TextBox x:Name="FeedbackAddress" MaxLength="600" AutomationProperties.Name="腾讯问卷公开填写链接" Margin="0,6,0,0"/>
              <TextBlock Text="仅用于接收反馈，不需要填写者登录。保存偏好后生效。" Style="{StaticResource Muted}" Margin="0,5,0,0"/>
            </StackPanel></Expander>
          </StackPanel>
        </Expander>
        <Border BorderBrush="#D9DEEA" BorderThickness="0,1,0,1" Padding="0,15" Margin="0,0,0,16">
          <StackPanel><DockPanel><TextBlock Text="应用更新" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Button DockPanel.Dock="Right" Content="检查更新" Click="Check_Click" HorizontalAlignment="Right" Margin="12,0,0,0"/></DockPanel>
            <TextBlock x:Name="UpdateMessage" Text="启动时检查正式版本，由你决定何时更新。" Style="{StaticResource Muted}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock x:Name="ReleaseNotes" Style="{StaticResource Muted}" MaxHeight="120" Margin="0,6,0,0"/>
            <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Height="4" Margin="0,10,0,0" Visibility="Collapsed"/>
            <Button x:Name="CancelDownload" Content="取消下载" Click="CancelDownload_Click" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed"/>
            <WrapPanel x:Name="UpdateActions" Visibility="Collapsed" Margin="0,12,0,0"><Button x:Name="InstallButton" Content="更新并重新打开" Style="{StaticResource Primary}" Click="Update_Click"/><Button Content="稍后" Click="Later_Click"/></WrapPanel>
          </StackPanel>
        </Border>
        <DockPanel><Image Source="Assets/help.jpg" Width="46" Height="46" Stretch="UniformToFill" Margin="0,0,12,0"/>
          <StackPanel><TextBlock Text="遇到问题了？" FontWeight="SemiBold"/><TextBlock Text="右边填写反馈，我会尽快修复。" Style="{StaticResource Muted}"/></StackPanel>
          <Button Content="问题反馈" Click="Feedback_Click" HorizontalAlignment="Right" Margin="12,0,0,0"/></DockPanel>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,18,0,0"><TextBlock x:Name="VersionLabel" Text="v0.7.1" Foreground="#536077" FontSize="12"/>
      <TextBlock Text="溣符雨 · 维护" Foreground="#994269" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
  </Grid>
</Window>
